#!/usr/bin/env bash
# Git pre-push adapter. In client projects, work reaches main only through a reviewed pull request.
root="$(git rev-parse --show-toplevel)"
grep -q '^profile=client' "$root/.buildkit" 2>/dev/null || exit 0
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Build Kit: this is a client project, so main only changes through a pull request." >&2
    echo "Push a branch instead (git push -u origin <branch>) and open a pull request." >&2
    exit 1
  fi
done
exit 0
